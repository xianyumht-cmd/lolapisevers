{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groupguard.local/contracts/groupguard-query-delivery.v1.schema.json",
  "title": "GroupGuard Query Delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "ok",
    "feature",
    "request_id",
    "client_request_id",
    "delivery",
    "error",
    "retry",
    "meta"
  ],
  "properties": {
    "protocol": {"const": "groupguard-query-delivery.v1"},
    "ok": {"type": "boolean"},
    "feature": {"type": "string", "minLength": 1, "maxLength": 64},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "client_request_id": {"type": "string", "maxLength": 128},
    "delivery": {"$ref": "#/$defs/delivery"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/error"}
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "after_seconds"],
      "properties": {
        "allowed": {"type": "boolean"},
        "after_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "meta": {"type": "object"}
  },
  "$defs": {
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "segments"],
      "properties": {
        "kind": {"enum": ["segments", "forward"]},
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    },
    "segment": {
      "oneOf": [
        {"$ref": "#/$defs/textSegment"},
        {"$ref": "#/$defs/imageSegment"},
        {"$ref": "#/$defs/forwardSegment"}
      ]
    },
    "textSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "maxLength": 20000}
      }
    },
    "imageSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mime_type", "encoding", "data", "filename", "bytes", "sha256"],
      "properties": {
        "type": {"const": "image"},
        "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "encoding": {"const": "base64"},
        "data": {"type": "string", "contentEncoding": "base64"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 128},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "forwardSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodes"],
      "properties": {
        "type": {"const": "forward"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segments"],
            "properties": {
              "segments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "oneOf": [
                    {"$ref": "#/$defs/textSegment"},
                    {"$ref": "#/$defs/imageSegment"}
                  ]
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "user_message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 96},
        "user_message": {"type": "string", "minLength": 1, "maxLength": 500},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
