{
  "schema": "lapi-parser-center.v1",
  "features": {
    "lolban": {
      "operation": "query",
      "providers": [
        {
          "id": "lolban-primary",
          "name": "封号查询主接口",
          "enabled": false,
          "request": {
            "method": "GET",
            "url": "http://q.lolmap.cn/api/query.html",
            "query": {
              "qq": "$qq",
              "token": "$secret:LOLMAP_API_TOKEN"
            },
            "timeout_seconds": 10
          },
          "parser": {
            "success": {
              "path": "code",
              "op": "eq",
              "value": 200
            },
            "error_message_paths": [
              "msg",
              "message",
              "error"
            ],
            "outcomes": [
              {
                "name": "hit",
                "when": {
                  "path": "data.status",
                  "op": "eq",
                  "value": "封禁"
                }
              },
              {
                "name": "clear",
                "when": {
                  "path": "data.status",
                  "op": "eq",
                  "value": "正常"
                }
              }
            ],
            "default_outcome": "unknown",
            "fields": {
              "qq": {
                "paths": [
                  "data.qq"
                ],
                "required": true,
                "string": true
              },
              "status": {
                "paths": [
                  "data.status"
                ],
                "required": true,
                "string": true
              },
              "ban_time": {
                "paths": [
                  "data.ban_time",
                  "data.banTime"
                ],
                "string": true
              },
              "end_time": {
                "paths": [
                  "data.end_time",
                  "data.endTime",
                  "data.left_time"
                ],
                "string": true
              },
              "ban_reason": {
                "paths": [
                  "data.ban_reason",
                  "data.reason",
                  "data.punish.reason",
                  "data.punish_reason"
                ],
                "default": "第三方接口未提供封禁原因",
                "string": true
              },
              "message": {
                "paths": [
                  "msg",
                  "message"
                ],
                "string": true
              }
            },
            "templates": {
              "hit": "账号封禁查询结果\n\nQQ号码：{qq}\n账号状态：{status}\n封禁原因：{ban_reason|第三方接口未提供封禁原因}\n封禁时间：{ban_time|未提供}\n剩余时间：{end_time|未提供}",
              "clear": "账号封禁查询结果\n\nQQ号码：{qq}\n账号状态：{status}",
              "unknown": "账号封禁查询失败：第三方响应状态无法识别"
            }
          }
        }
      ]
    }
  }
}
