{
  "schema": "lapi-parser-center.v1",
  "features": {
    "lolban": {
      "operation": "query",
      "providers": [
        {
          "id": "lolban-primary",
          "name": "封号查询主接口",
          "enabled": false,
          "request": {
            "method": "GET",
            "url": "http://q.lolmap.cn/api/query.html",
            "query": {
              "qq": "$qq",
              "token": "$secret:LOLMAP_API_TOKEN"
            },
            "timeout_seconds": 10
          },
          "parser": {
            "success": {
              "path": "code",
              "op": "eq",
              "value": 200
            },
            "error_message_paths": [
              "msg",
              "message",
              "error"
            ],
            "outcomes": [
              {
                "name": "hit",
                "when": {
                  "path": "data.status",
                  "op": "eq",
                  "value": "封禁"
                }
              },
              {
                "name": "clear",
                "when": {
                  "path": "data.status",
                  "op": "eq",
                  "value": "正常"
                }
              }
            ],
            "default_outcome": "unknown",
            "fields": {
              "qq": {
                "paths": [
                  "data.qq"
                ],
                "required": true,
                "string": true
              },
              "status": {
                "paths": [
                  "data.status"
                ],
                "required": true,
                "string": true
              },
              "ban_time": {
                "paths": [
                  "data.ban_time",
                  "data.banTime"
                ],
                "string": true
              },
              "end_time": {
                "paths": [
                  "data.end_time",
                  "data.endTime",
                  "data.left_time"
                ],
                "string": true
              },
              "ban_reason": {
                "paths": [
                  "data.ban_reason",
                  "data.reason",
                  "data.punish.reason",
                  "data.punish_reason"
                ],
                "default": "第三方接口未提供封禁原因",
                "string": true
              },
              "message": {
                "paths": [
                  "msg",
                  "message"
                ],
                "string": true
              }
            },
            "templates": {
              "hit": "账号封禁查询结果\n\nQQ号码：{qq}\n账号状态：{status}\n封禁原因：{ban_reason|第三方接口未提供封禁原因}\n封禁时间：{ban_time|未提供}\n剩余时间：{end_time|未提供}",
              "clear": "账号封禁查询结果\n\nQQ号码：{qq}\n账号状态：{status}",
              "unknown": "账号封禁查询失败：第三方响应状态无法识别"
            }
          }
        }
      ]
    },
    "scammer": {
      "operation": "query",
      "providers": []
    },
    "peer": {
      "operation": "query",
      "providers": []
    },
    "scammer_report": {
      "operation": "report",
      "providers": [
        {
          "id": "pianzi-lol-anonymous-report",
          "name": "骗子举报审核入口",
          "enabled": false,
          "request": {
            "method": "POST",
            "url": "https://pianzi.lol/api/anonymous/report",
            "headers": {
              "X-LAPI-Request-Encoding": "multipart"
            },
            "form": {
              "report_identity_mode": "anonymous",
              "scammer_qq": "$qq",
              "scammer_name": "",
              "scammer_wechat": "",
              "scammer_phone": "",
              "scammer_idcard": "",
              "fraud_amount": "",
              "incident_at": "",
              "transaction_method": "",
              "report_content": "$content",
              "evidence_notes": ""
            },
            "timeout_seconds": 15
          },
          "parser": {
            "success": {
              "path": "success",
              "op": "eq",
              "value": true
            },
            "error_message_paths": [
              "error",
              "message"
            ],
            "outcomes": [
              {
                "name": "pending",
                "when": {
                  "path": "success",
                  "op": "eq",
                  "value": true
                }
              }
            ],
            "default_outcome": "unknown",
            "fields": {
              "review_status": {
                "paths": [
                  "review_status",
                  "status"
                ],
                "default": "等待审核",
                "string": true
              },
              "receipt": {
                "paths": [
                  "message"
                ],
                "default": "举报已提交，等待审核",
                "string": true
              }
            },
            "templates": {
              "pending": "审核状态：{review_status|等待审核}\n回执说明：{receipt|举报已提交，等待审核}",
              "unknown": "举报提交结果暂无法确认"
            }
          }
        }
      ]
    },
    "peer_report": {
      "operation": "report",
      "providers": []
    }
  }
}
